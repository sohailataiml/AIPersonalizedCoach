# Copy to .env and adjust. No secrets are committed to this repo.
# Every value below has a working default: the app runs with an empty .env.
#
# Two profiles are documented here:
#   LOCAL  - zero infrastructure, in-memory graph, offline LLM stub
#   RENDER - the deployed demo, real Neo4j over the private network
# The RENDER values are set by render.yaml or in the Render dashboard; they are
# listed for reference, not to be pasted into a local .env.

# --- Graph backend -----------------------------------------------------------
# "memory" runs the identical traversals with no database (LOCAL default).
# "neo4j"  uses a real Neo4j. In neo4j mode there is NO fallback to memory: if
#          the database is unreachable the service reports itself not-ready
#          rather than silently swapping the storage engine under a safety
#          system.
GRAPH_BACKEND=memory
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=futurecoach
NEO4J_DATABASE=neo4j

# Set by the deployment from Render's private-service reference; when present
# it wins over NEO4J_URI, so the hostname is resolved by the platform rather
# than guessed. Leave unset locally.
# NEO4J_HOST=future-coach-neo4j
# NEO4J_PORT=7687

# Cold deploys race Neo4j's boot. Bounded retry, then readiness fails cleanly.
NEO4J_CONNECT_ATTEMPTS=12
NEO4J_CONNECT_TIMEOUT_SECONDS=8
NEO4J_CONNECT_BACKOFF_SECONDS=1.5
NEO4J_CONNECT_MAX_BACKOFF_SECONDS=10

# Idempotent graph bootstrap on startup (MERGE, never wipe). Leave on.
GRAPH_BOOTSTRAP=true

# --- Deployment --------------------------------------------------------------
# Cosmetic label shown in Technical Details ("local" / "render"). Never used
# for behaviour: the deployment must not take a different code path from the
# one that was evaluated.
ENVIRONMENT=local

# --- LLM ---------------------------------------------------------------------
# "stub" is deterministic and offline: the whole app, including the safety gate
# and provenance, works with no API key. Set anthropic/openai for real prose.
LLM_PROVIDER=stub
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_MODEL=gpt-4o-mini

# --- Resolver thresholds -----------------------------------------------------
FUZZY_ACCEPT_THRESHOLD=0.88
EMBEDDING_ACCEPT_THRESHOLD=0.82

# --- MCP ---------------------------------------------------------------------
# The AI-facing MCP server is mounted at /mcp on the same FastAPI app.
# DNS-rebinding protection is on by default and validates the Host header, so a
# deployment must list its public hostname or MCP requests answer 421. The
# protection is never disabled; the allow-list is configured instead.
MCP_ENABLED=true
MCP_ALLOWED_HOSTS=["localhost","localhost:8000","127.0.0.1","127.0.0.1:8000"]
MCP_ALLOWED_ORIGINS=[]

# --- API / CORS --------------------------------------------------------------
# The deployed frontend origin is appended to the local development origins.
# A bare hostname is upgraded to https://. Never "*" - the API allows
# credentials, and a wildcard with credentials is both invalid and unsafe.
# FRONTEND_ORIGIN=future-coach-frontend.onrender.com

# --- Frontend ----------------------------------------------------------------
# Local: absolute backend URL. On Render this is "/api" and the Next server
# proxies to BACKEND_ORIGIN, so the browser only ever talks to one origin.
NEXT_PUBLIC_API_BASE=http://localhost:8000/api

# =============================================================================
# RENDER BACKEND (set by render.yaml; the two secrets are entered manually)
# =============================================================================
#   ENVIRONMENT=render
#   GRAPH_BACKEND=neo4j
#   NEO4J_HOST=<fromService future-coach-neo4j property: host>
#   NEO4J_PORT=7687
#   NEO4J_USER=neo4j
#   NEO4J_PASSWORD=<secret - must match the password inside NEO4J_AUTH>
#   NEO4J_DATABASE=neo4j
#   MCP_ENABLED=true
#   MCP_ALLOWED_HOSTS=["future-coach-backend.onrender.com"]
#   FRONTEND_ORIGIN=<fromService future-coach-frontend property: host>
#
# RENDER NEO4J (private service, persistent disk at /data)
#   NEO4J_AUTH=neo4j/<same secret>          <-- the one manual secret
